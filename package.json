{
  "name": "confwrite",
  "version": "0.29.1",
  "description": "ConfWrite — 脚本驱动的长文档生成 pi package",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "npm pack",
    "install-pi": "bash scripts/install.sh",
    "version": "node scripts/version.js",
    "release": "release-it",
    "docs:check": "node scripts/check-docs.js",
    "sdd:check": "node scripts/check-sdd.js",
    "prepare": "husky"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "."
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "^0.32.0",
    "docx": "^8.5.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "marked": "^12.0.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "release-it": "^21.1.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist/",
    "knowledge/",
    "templates/",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "lint-staged": {
    "*.ts": [
      "node scripts/pre-commit-check.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
