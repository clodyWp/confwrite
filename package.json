{
  "name": "confwrite",
  "version": "0.12.1",
  "description": "ConfWrite — 脚本驱动的长文档生成 pi package",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": ["pi-package"],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm pack",
    "install-pi": "bash scripts/install.sh",
    "version": "node scripts/version.js"
  },
  "pi": {
    "extensions": [
      "dist/index.js"
    ],
    "skills": [
      "."
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "^0.32.0",
    "docx": "^8.5.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "marked": "^12.0.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist/",
    "knowledge/",
    "templates/",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
